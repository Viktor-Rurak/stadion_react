# Налаштування трансляції. Скопіюйте цей файл у stream.env і заповніть.
# У stream.env буде пароль від камери й ключ трансляції — нікому його
# не пересилайте й не кладіть у git.

# --- Камера (реєстратор Hikvision) ---
# Адреса, за якою реєстратор видно з інтернету (зовнішня IP або домен)
CAMERA_HOST=
# Порт RTSP, який прокинутий на роутері стадіону (на самому реєстраторі — 554)
CAMERA_RTSP_PORT=554
# Окремий користувач реєстратора лише з правом перегляду — НЕ admin.
# Пароль беріть із літер і цифр: символи @ : / # ламають адресу потоку.
CAMERA_USER=stream
CAMERA_PASSWORD=
# Номер камери — як «Camera No.» у застосунку
CAMERA_CHANNEL=15

# --- YouTube ---
# Ключ трансляції зі «YouTube Studio -> Створити -> Почати трансляцію -> Ключ потоку».
# Хто має цей ключ, той може вести трансляцію від імені каналу.
YOUTUBE_KEY=

# Якість, якщо доводиться перекодовувати (камера віддає H.265).
# 2500k — 720p, 4000k — 1080p. Більше навантаження на сервер і на інтернет стадіону.
VIDEO_BITRATE=2500k
