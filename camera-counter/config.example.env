# Налаштування лічильника людей. Скопіюйте цей файл у config.env і заповніть.
# У config.env є паролі — нікому його не пересилайте й не публікуйте.

# --- Камера (реєстратор Hikvision) ---
# Адреса реєстратора В МЕРЕЖІ СТАДІОНУ (внутрішня, не зовнішня), напр. 192.168.1.64
CAMERA_HOST=192.168.1.64
CAMERA_HTTP_PORT=80
CAMERA_RTSP_PORT=554
# Окремий користувач лише з правом перегляду (не admin!)
CAMERA_USER=stream
CAMERA_PASSWORD=
# Номер камери — як «Camera No.» у застосунку
CAMERA_CHANNEL=15

# --- Сайт ---
SUPABASE_URL=https://fudrgpsrbfeqwszsdaxf.supabase.co
SUPABASE_KEY=sb_publishable_uNNwiihkct30ojFNrfOjbw_KAtdhoYL
# Секретний ключ пристрою: дозволяє лише надсилати кількість людей на штучному полі
DEVICE_TOKEN=

# --- Підрахунок ---
# Як часто рахувати, секунд
INTERVAL_SECONDS=60
# yolo11n.pt — найшвидша; yolo11s.pt — точніша, але повільніша
MODEL=yolo11n.pt
# Наскільки нейромережа має бути впевнена, що це людина (від 0 до 1)
MIN_CONFIDENCE=0.35
# Межі поля на кадрі, щоб не рахувати глядачів за сіткою.
# Точки «x,y» через «;» у частках кадру (0,0 — лівий верхній кут, 1,1 — правий нижній).
# Порожньо — рахувати весь кадр. Підібрати межі: start.bat --once --debug --no-send
FIELD_ZONE=
